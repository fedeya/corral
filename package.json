{
  "name": "corral",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/plugin", "apps/web"],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "test": "bun run test:plugin && bun run test:web",
    "test:plugin": "bun run --cwd apps/plugin test",
    "test:web": "bun run --cwd apps/web test",
    "build": "bun run --filter '*' build",
    "build:plugin": "bun run --cwd apps/plugin build",
    "build:web": "bun run --cwd apps/web build",
    "watch": "bun run --cwd apps/plugin watch",
    "typecheck": "bun run --filter '*' typecheck",
    "preview": "bun run --cwd apps/plugin preview",
    "media": "bun run --cwd apps/plugin media",
    "demo": "bun run --cwd apps/plugin demo",
    "link": "bun run --cwd apps/plugin link",
    "restart": "bun run --cwd apps/plugin restart",
    "validate": "bun run --cwd apps/plugin validate"
  }
}
